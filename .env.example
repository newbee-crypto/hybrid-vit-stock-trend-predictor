# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# API Keys — Copy this file to .env and fill in your keys
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Google Gemini API Key (for LLM explanations)
GOOGLE_API_KEY=your_google_api_key_here

# Tavily API Key (for news sentiment search)
TAVILY_API_KEY=your_tavily_api_key_here
